                  "fill": "$color.bg.tertiary",
                  "cornerRadius": 12,
                  "stroke": {
                    "thickness": 1,
                    "fill": "$color.border"
                  },
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 18,
                  "children": [
                    {
                      "type": "text",
                      "id": "directory-v2-preview-h1",
                      "fill": "$color.text",
                      "content": "目录设计要点",
                      "fontFamily": "$font.family",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "directory-v2-preview-p1",
                      "fill": "$color.text.secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "三段式：笔记本（空间）→ 分区/分组（语义聚合）→ 页面树（无限层级）。左侧承载结构，右侧承载视图（文档/星链/脑图/演示）。",
                      "lineHeight": 1.6,
                      "fontFamily": "$font.family",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "directory-v2-preview-p2",
                      "fill": "$color.text.secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "无限层级通过“分区/分组”削峰，让树深度可控；页面支持子页面，同时支持星链作为非层级补充。",
                      "lineHeight": 1.6,
                      "fontFamily": "$font.family",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "directory-v2-storage",
      "x": 0,
      "y": 760,
      "name": "目录设计v2-存储结构（CodeHelp式：稳定ID + 内容与资源同目录）",
      "clip": true,
      "width": 1120,
      "height": 520,
      "fill": "$color.bg",
      "stroke": {
        "thickness": 1,
        "fill": "$color.border"
      },
      "layout": "vertical",
      "gap": 12,
      "padding": 16,
      "children": [
        {
          "type": "text",
          "id": "directory-v2-storage-title",
          "fill": "$color.text",
          "content": "文档存储建议（跨平台友好）",
          "fontFamily": "$font.family",
          "fontSize": 16,
          "fontWeight": "700"
        },
        {
          "type": "frame",
          "id": "directory-v2-storage-box",
          "name": "StorageBox",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.tertiary",
          "cornerRadius": 12,
          "stroke": {
            "thickness": 1,
            "fill": "$color.border"
          },
          "layout": "vertical",
          "gap": 10,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "directory-v2-storage-tree",
              "fill": "$color.text.secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "axon-kb/\n  .axon/\n    spaces.json\n    notebooks.json\n    nodes.jsonl\n    links.jsonl\n  nodes/\n    n_01H.../\n      meta.json\n      content.md\n      assets/\n        image-001.png\n    n_01H.../\n      meta.json\n      content.md\n  exports/\n    mindmap/\n    slides/\n",
              "lineHeight": 1.5,
              "fontFamily": "$font.family",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "directory-v2-storage-note-1",
              "fill": "$color.text.secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "meta.json：{ id, type, title, parentId, notebookId, sectionId, order, createdAt, updatedAt, tags, pinned, archived }\nlinks.jsonl：用于星链/图谱（双向链接、引用、块级链接均可映射）\ncontent.md 与 assets 同目录：重命名/移动不影响引用，Windows 路径限制更安全。",
              "lineHeight": 1.6,
              "fontFamily": "$font.family",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    }
  ],
